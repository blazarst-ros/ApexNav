<launch>
    <arg name="map_size_x_"/>
    <arg name="map_size_y_"/>

    <arg name="odometry_topic_"/>
    <arg name="sensor_pose_topic_"/>
    <arg name="depth_topic_"/>
    <arg name="camera_info_topic_"/>
    <arg name="map_commit_topic_" default="/grid_map/commit"/>

    <arg name="cx_"/>
    <arg name="cy_"/>
    <arg name="fx_"/>
    <arg name="fy_"/>
    <arg name="depth_unit_scale_" default="0.0"/>
    <arg name="world_frame_" default="world"/>
    <arg name="body_frame_" default="base_link"/>
    <arg name="planning_param_file_" default="$(find trajectory_manager)/config/planning_param.yaml"/>
    <arg name="obstacles_inflation_" default="0.18"/>
    <arg name="filter_min_height_" default="0.28"/>
    <arg name="filter_max_height_" default="1.18"/>
    <arg name="height_filter_reference_" default="world"/>
    <arg name="depth_filter_maxdist_" default="4.99"/>
    <arg name="depth_filter_mindist_" default="0.20"/>
    <!-- Kept only so existing exploration_traj.launch callers remain valid;
         the mapper uses the explicit oriented footprint below. -->
    <arg name="self_filter_radius_" default="0.0"/>
    <arg name="self_filter_length_" default="0.70"/>
    <arg name="self_filter_width_" default="0.70"/>
    <arg name="self_filter_tolerance_" default="0.000001"/>
    <arg name="camera_forward_offset_" default="0.10"/>
    
    <!-- Real-world mode flag (default to false for simulation) -->
    <arg name="is_real_world_" default="false"/>

    <!-- main node -->
    <node pkg="exploration_manager" name="exploration_node" type="exploration_node" output="screen">
        <!-- Load trajectory planning parameters for real-world mode -->
        <rosparam file="$(arg planning_param_file_)" command="load" />

        <remap from ="/odom_world"    to = "$(arg odometry_topic_)"/>
        <remap from ="/map_ros/pose"  to = "$(arg sensor_pose_topic_)"/>
        <remap from ="/map_ros/depth" to = "$(arg depth_topic_)"/>
        <remap from ="/map_ros/camera_info" to = "$(arg camera_info_topic_)"/>
        <remap from ="/grid_map/commit" to = "$(arg map_commit_topic_)"/>

        <!-- FSM mode selection -->
        <param name="is_real_world" value="$(arg is_real_world_)" type="bool"/>

        <!-- Mapping -->
        <!-- ray_mode = 0: penetrate ; ray_mode = 1: non-penetrate -->
        <param name="sdf_map/ray_mode" value="0" />
        <param name="sdf_map/resolution" value="0.05" />
        <param name="sdf_map/map_size_x" value="$(arg map_size_x_)" />
        <param name="sdf_map/map_size_y" value="$(arg map_size_y_)" />
        <param name="sdf_map/obstacles_inflation" value="$(arg obstacles_inflation_)" />
        <param name="sdf_map/local_bound" value="5.0"/>

        <param name="sdf_map/p_hit" value="0.90"/>
        <param name="sdf_map/p_miss" value="0.48"/>
        <param name="sdf_map/p_min" value="0.10"/>
        <param name="sdf_map/p_max" value="0.98"/>
        <param name="sdf_map/p_occ" value="0.80"/>
        <param name="sdf_map/max_ray_length" value="$(arg depth_filter_maxdist_)"/>
        <param name="sdf_map/optimistic" value="false" type="bool"/>
        <param name="sdf_map/signed_dist" value="false" type="bool"/>

        <param name="map_ros/cx" value="$(arg cx_)"/>
        <param name="map_ros/cy" value="$(arg cy_)"/>
        <param name="map_ros/use_camera_info" value="true" type="bool"/>
        <param name="map_ros/enable_legacy_semantics" value="false" type="bool"/>
        <param name="map_ros/require_downward_camera" value="false" type="bool"/>
        <param name="map_ros/mapping_history_sec" value="5.0"/>
        <param name="map_ros/semantic_match_tolerance" value="0.05"/>
        <param name="map_ros/camera_info_match_tolerance" value="0.01"/>
        <param name="map_ros/fx" value="$(arg fx_)"/>
        <param name="map_ros/fy" value="$(arg fy_)"/>
        <param name="map_ros/depth_filter_maxdist" value="$(arg depth_filter_maxdist_)"/>
        <param name="map_ros/depth_filter_mindist" value="$(arg depth_filter_mindist_)"/>
        <param name="map_ros/self_filter_length" value="$(arg self_filter_length_)"/>
        <param name="map_ros/self_filter_width" value="$(arg self_filter_width_)"/>
        <param name="map_ros/self_filter_tolerance" value="$(arg self_filter_tolerance_)"/>
        <param name="map_ros/max_source_age_sec" value="1.0"/>
        <param name="map_ros/max_future_sec" value="0.05"/>
        <param name="map_ros/camera_forward_offset" value="$(arg camera_forward_offset_)"/>
        <param name="map_ros/depth_filter_margin" value="2"/>
        <param name="map_ros/filter_min_height" value="$(arg filter_min_height_)"/>
        <param name="map_ros/filter_max_height" value="$(arg filter_max_height_)"/>
        <param name="map_ros/height_filter_reference" value="$(arg height_filter_reference_)" type="string"/>
        <param name="map_ros/k_depth_scaling_factor" value="65535.0"/>
        <param name="map_ros/depth_unit_scale" value="$(arg depth_unit_scale_)"/>
        <param name="map_ros/skip_pixel" value="1"/>
        <param name="map_ros/frame_id" value="$(arg world_frame_)"/>
        <param name="fsm/base_frame" value="$(arg body_frame_)"/>
        <param name="fsm/trigger_max_age" value="1.00" type="double"/>
        <param name="fsm/odometry_max_age" value="0.20" type="double"/>
        <param name="fsm/input_max_future" value="0.05" type="double"/>
        <param name="fsm/odometry_quaternion_norm_tolerance" value="0.05" type="double"/>
        <param name="fsm/first_trajectory_progress_limit" value="0.25" type="double"/>
        <param name="map_ros/virtual_ground_height" value="-0.34"/>

        <param name="fsm/replan_time" value="0.30" type="double"/>
        <param name="fsm/replan_traj_end_threshold" value="1.0" type="double"/>
        <!-- Commit to a short local segment before ordinary map changes may
             replace it. Safety checks can still stop immediately. -->
        <param name="fsm/replan_frontier_change_delay" value="2.5" type="double"/>
        <param name="fsm/replan_timeout" value="6.0" type="double"/>
        <param name="fsm/replan_wall_timeout" value="12.0" type="double"/>
        <param name="fsm/replan_min_execution_time" value="2.5" type="double"/>
        <param name="fsm/replan_min_progress" value="0.25" type="double"/>
        <param name="fsm/local_target_distance" value="1.0" type="double"/>
        <!-- The 0.70 x 0.70 m footprint has a 0.495 m circumradius. A 0.10 m
             first step remains inside the mapper's 0.65 m launch clear bubble. -->
        <param name="fsm/local_target_min_progress" value="0.10" type="double"/>
        <param name="fsm/plan_failure_retry_sec" value="0.25" type="double"/>
        <!-- Multirotor tracking tolerance: absorb short yaw/position transients,
             reanchor persistent drift, and retain a separate hard stop. -->
        <param name="fsm/tracking_reanchor_threshold" value="0.25" type="double"/>
        <param name="fsm/tracking_error_threshold" value="0.40" type="double"/>
        <param name="fsm/tracking_error_hold_sec" value="0.60" type="double"/>
        <!-- Hard post-optimization limits leave margin below the supervisor caps. -->
        <param name="fsm/trajectory_speed_limit" value="0.30" type="double"/>
        <param name="fsm/trajectory_yaw_rate_limit" value="0.55" type="double"/>
        <param name="fsm/replan_settle_speed" value="0.05" type="double"/>
        <param name="fsm/replan_settle_sec" value="0.50" type="double"/>
        <param name="fsm/trajectory_start_tolerance" value="0.10" type="double"/>
        <param name="fsm/target_lock_sec" value="10.0" type="double"/>
        <param name="fsm/target_reached_distance" value="0.35" type="double"/>
        <param name="fsm/target_failure_limit" value="3" type="int"/>
        <!-- Release an unreachable target only after both three failures and
             two seconds of real failure age; safety/reached gates remain immediate. -->
        <param name="fsm/target_failure_min_hysteresis" value="2.0" type="double"/>

        <!-- Exploration manager -->
        <!-- 0: distance 1: semantic 2: hybrid(TSP sem + closest dist) 3: TSP(distance) -->
        <param name="exploration/policy" value="2" type="int"/>
        <param name="exploration/sigma_threshold" value="0.015" type="double"/>
        <param name="exploration/max_to_mean_threshold" value="1.10" type="double"/>
        <param name="exploration/max_to_mean_percentage" value="0.90" type="double"/>
        <param name="exploration/tsp_dir" value="$(find lkh_mtsp_solver)/resource" type="string"/>

        <param name="frontier/cluster_min" value="5" type="int"/>
        <param name="frontier/cluster_size_xy" value="0.65" type="double"/>
        <param name="frontier/min_view_finish_fraction" value="0.2" type="double"/>
        <param name="frontier/min_contain_unknown" value="30" type="int"/>

        <param name="object/min_observation_num" value="2" type="int"/>
        <!-- 0: no_fusion 1: ours_fusion 2: max_fusion-->
        <param name="object/fusion_type" value="1" type="int"/>
        <param name="object/use_observation" value="true" type="bool"/>
        <param name="object/vis_cloud" value="true" type="bool"/>

        <!-- Perception utils -->
        <param name="perception_utils/left_angle" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
        <param name="perception_utils/right_angle" value="$(eval 30 * 3.1415926 / 180.0)" type="double"/>
        <param name="perception_utils/max_dist" value="4.0" type="double"/>
        <param name="perception_utils/vis_dist" value="1.0" type="double"/>

        <!-- path searching -->
        <param name="astar/lambda_heu" value="1.0" type="double"/>
        <param name="astar/resolution_astar" value="0.1" type="double"/>
    </node>

    <!-- ATSP solver -->
    <node pkg="lkh_mtsp_solver" name="tsp_solver" type="tsp_node" output="log">
        <param name="exploration/tsp_dir" value="$(find lkh_mtsp_solver)/resource" type="string"/>
    </node>
</launch>
