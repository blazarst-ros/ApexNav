defaults:
  - /benchmark/nav/objectnav:
      - objectnav_hm3d
  - _self_

habitat_baselines:
  evaluate: True
  force_torch_single_threaded: True

habitat:
  dataset:
    split: val
    data_path: data/datasets/objectnav/hm3d/v1/{split}/{split}.json.gz # HM3D-v1 dataset
  environment:
    max_episode_steps: 500
    iterator_options:
      cycle: false
      shuffle: false
      max_scene_repeat_steps: 10000000
  task:
    lab_sensors:
      gps_sensor:
        type: GPSSensor
        dimensionality: 3
    measurements:
      success:
        success_distance: 0.2
  simulator:
    habitat_sim_v0:
      allow_sliding: false
    forward_step_size: 0.25
    turn_angle: 30
    # Multi-agent configuration: two agents in the same environment
    agents:
      agent_0:
        radius: 0.18
        start_position: [0, 0, 0]  # Will be overridden programmatically
        start_rotation: [0, 0, 0, 1]
        sim_sensors:
          rgb_sensor:
            width: 640
            height: 480
            hfov: 79
            position: [0, 0.88, 0]
            orientation: [0, 0, 0]
            type: RGBSensor
          depth_sensor:
            width: 640
            height: 480
            hfov: 79
            min_depth: 0.0
            max_depth: 5.0
            normalize_depth: true
            position: [0, 0.88, 0]
            orientation: [0, 0, 0]
            type: DepthSensor
          gps_sensor:
            type: GPSSensor
            dimensionality: 3
          compass_sensor:
            type: CompassSensor
            dimensionality: 1
      agent_1:
        radius: 0.18
        start_position: [0, 0, 0]  # Will be overridden programmatically
        start_rotation: [0, 0, 0, 1]
        sim_sensors:
          rgb_sensor:
            width: 640
            height: 480
            hfov: 79
            position: [0, 0.88, 0]
            orientation: [0, 0, 0]
            type: RGBSensor
          depth_sensor:
            width: 640
            height: 480
            hfov: 79
            min_depth: 0.0
            max_depth: 5.0
            normalize_depth: true
            position: [0, 0.88, 0]
            orientation: [0, 0, 0]
            type: DepthSensor
          gps_sensor:
            type: GPSSensor
            dimensionality: 3
          compass_sensor:
            type: CompassSensor
            dimensionality: 1

# Number of agents (used by Python code to iterate over agents)
num_agents: 2

detector:
  yolo:
    confidence_threshold_yolo: 0.3
    iou_threshold_yolo: 0.5
    agnostic_nms: True

  groundingDINO:
    confidence_threshold_dino: 0.40
    text_threshold: 0.25

llm:
  llm_answer_path: llm/answers/llm_answer_hm3d.txt
  llm_response_path: llm/answers/llm_response_list.txt
  llm_client:
    llm_client: deepseek # deepseek, ollama or none
    #ollama: "qwen3:8b"

# Multi-agent specific settings
multiagent:
  episode_termination: cooperative  # "cooperative" (any succeeds) or "independent" (all finish)
  inter_agent_avoidance: false  # Whether agents avoid each other during path planning
  agent_spawn_offset: 1.0  # Meters to offset agent_1 from agent_0's start position

record_file_name: "record.txt"
continue_file_name: "continue.txt"
need_video: false
video_output_path: "videos/test_hm3dv1_multiagent_{split}"
test_epi_num: -1
